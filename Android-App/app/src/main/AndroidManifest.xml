<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Only needed for optional Firebase sign-in. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Head/face tracking (front camera, processed on-device) and voice commands. Both are
         optional: if either is denied PWDe falls back to a labelled demo mode or typed commands. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-feature android:name="android.hardware.camera.front" android:required="false" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />

    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <queries>
        <!-- Lets TextToSpeech find the installed engine on Android 11+. -->
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
        <!-- Lets SpeechRecognizer find the installed recognition service on Android 11+. -->
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
        <!-- Lets PWDe see whether a supported game is installed and launch it. Android 11+
             filters package visibility, so without these getLaunchIntentForPackage() returns null
             and an installed game is misreported as "isn't installed". These MUST match
             Game.packageName in data/model/Games.kt; GameQueriesManifestTest fails the build if
             they drift apart. -->
        <package android:name="com.mobile.legends" />
        <package android:name="com.supercell.clashroyale" />
    </queries>

    <application
        android:name=".PwdeApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Pwde">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.Pwde"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".accessibility.PwdeAccessibilityService"
            android:exported="false"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/pwde_accessibility_service" />
        </service>
    </application>

</manifest>
